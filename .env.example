# CalTrack works fully offline with no configuration at all.
#
# Cloud sync is optional. If you want to back up / sync your data across
# devices, create your own free Firebase project (console.firebase.google.com),
# enable Firestore + Google Auth, copy this file to `.env`, and fill in the
# values from your project's web app config.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Optional, on top of the above: real push notifications for meal reminders
# that arrive even when the app is fully closed — 100% free, no Blaze plan.
# Generate your own key pair (needs Node, run once, keep the private half
# secret — see README "Push notifications" for the full setup):
#   npx web-push generate-vapid-keys
VITE_VAPID_PUBLIC_KEY=
